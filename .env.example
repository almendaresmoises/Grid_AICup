# Copy this file to .env in the repository root.
# The API and the database migrator load it on startup.
# A variable already set in the environment is left as it is.
# Quote a value when the password contains spaces or semicolons.

# Supabase direct connection. Use port 5432.
# In the dashboard: Project Settings → Database → Connection string → Direct connection.
# Leave this commented while you are using the local database below.
# ConnectionStrings__Default=Host=db.YOUR_PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Local Docker Postgres. Comment this out when the Supabase line above is active.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=grid;Username=postgres;Password=password2026

# Optional. Leave the key empty to edit reconciliation profiles by hand.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Development uses docker compose (Pub/Sub on 8085, Cloud Storage on 4443).
# Production (Cloud Run) leaves PUBSUB_EMULATOR_HOST and STORAGE_EMULATOR_HOST unset
# and sets GoogleCloud__ProjectId and GoogleCloud__Bucket to the real project.
# Postgres is only ConnectionStrings__Default: local Docker, Supabase, or Cloud SQL.
GRID_ENV=Development
GoogleCloud__ProjectId=grid-local
GoogleCloud__Bucket=grid-local
GoogleCloud__ParserTopicId=grid-parser-runs
GoogleCloud__DatasetTopicId=grid-datasets
GoogleCloud__WorkerSecret=dev-worker-secret
PUBSUB_EMULATOR_HOST=localhost:8085
STORAGE_EMULATOR_HOST=http://localhost:4443
GOOGLE_CLOUD_PROJECT=grid-local
GCS_BUCKET=grid-local
GRID_WORKER_SECRET=dev-worker-secret
# Firebase production build. Empty keeps the Vite dev proxy.
VITE_API_URL=
